{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rakvor.example/schemas/item-technical.schema.json",
  "title": "Rakvor item technical review",
  "type": "object",
  "required": [
    "schema",
    "tool",
    "run",
    "item",
    "hashes",
    "findings",
    "limitations",
    "audit"
  ],
  "properties": {
    "schema": {
      "const": "rakvor.item-technical/1"
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "run": {
      "type": "object",
      "required": [
        "run_id",
        "actor",
        "frontend",
        "algorithms",
        "langs",
        "started_utc",
        "finished_utc",
        "elapsed_ms",
        "cancelled"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "case_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "actor": {
          "type": "string"
        },
        "frontend": {
          "type": "string"
        },
        "algorithms": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "md5",
              "sha1",
              "sha256",
              "sha512",
              "sha3-256",
              "blake3"
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "langs": {
          "type": "array",
          "items": {
            "enum": [
              "en",
              "es",
              "fr"
            ]
          },
          "minItems": 1
        },
        "started_utc": {
          "type": "string",
          "format": "date-time"
        },
        "finished_utc": {
          "type": "string",
          "format": "date-time"
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0
        },
        "cancelled": {
          "type": "boolean"
        }
      }
    },
    "item": {
      "type": "object",
      "required": [
        "index",
        "path",
        "file_name",
        "size",
        "status"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string"
        },
        "file_name": {
          "type": "string"
        },
        "size": {
          "type": "integer"
        },
        "modified_utc": {
          "type": [
            "string",
            "null"
          ]
        },
        "extension": {
          "type": [
            "string",
            "null"
          ]
        },
        "detected_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "attention",
            "problem"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^E[0-9]{4,}$",
          "description": "Case folder only: evidence id from the case registry (null when the run is not linked to a case or the item is not registered)."
        }
      }
    },
    "hashes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "md5",
          "sha1",
          "sha256",
          "sha512",
          "sha3-256",
          "blake3"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{32,128}$"
      },
      "maxProperties": 2
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "severity",
          "params",
          "text"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "low",
              "medium",
              "high"
            ]
          },
          "params": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "text": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "en",
                "es",
                "fr"
              ]
            },
            "additionalProperties": {
              "type": "object",
              "required": [
                "title",
                "shows",
                "does_not_prove"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "shows": {
                  "type": "string"
                },
                "does_not_prove": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "audit": {
      "type": "object",
      "required": [
        "first_seq",
        "last_seq"
      ],
      "properties": {
        "first_seq": {
          "type": "integer"
        },
        "last_seq": {
          "type": "integer"
        }
      }
    },
    "image": {
      "description": "Image analysis (null when the item is not an image): status, options, fingerprint databases, maps and the report summaries written by the analysis.",
      "type": [
        "object",
        "null"
      ],
      "required": [
        "analysis",
        "fingerprint_dbs",
        "maps"
      ],
      "properties": {
        "analysis": {
          "description": "completed, not_completed (worker failure, unreadable or unparseable file) or not_an_image (image name, no image signature).",
          "enum": [
            "completed",
            "not_completed",
            "not_an_image"
          ]
        },
        "parser": {
          "type": [
            "object",
            "null"
          ]
        },
        "options": {
          "type": [
            "object",
            "null"
          ]
        },
        "fingerprint_dbs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "role",
              "status"
            ],
            "properties": {
              "role": {
                "type": "string"
              },
              "status": {
                "type": "string"
              }
            }
          }
        },
        "evidence_rehash": {
          "type": [
            "object",
            "null"
          ]
        },
        "worker": {
          "type": [
            "object",
            "null"
          ]
        },
        "maps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Analysis maps under maps/ (the original preview is listed under original_preview, not here)."
        },
        "format": {
          "type": [
            "string",
            "null"
          ]
        },
        "width": {
          "type": [
            "integer",
            "null"
          ]
        },
        "height": {
          "type": [
            "integer",
            "null"
          ]
        },
        "original_preview": {
          "description": "maps/original.png: lossless RGB8 preview of the decoded pixels (file, width, height, params); null for HEIC or undecodable files.",
          "type": [
            "object",
            "null"
          ]
        },
        "map_parameters": {
          "description": "The parameters recorded with each map ({file, params}).",
          "type": [
            "array",
            "null"
          ]
        },
        "metadata_summary": {
          "description": "Key metadata fields, tag counts per group, GPS/MakerNote/ICC/XMP presence, xmpMM:History events, reading problems.",
          "type": [
            "object",
            "null"
          ]
        },
        "structure_summary": {
          "description": "Top-level segment sequence and per-format facts.",
          "type": [
            "object",
            "null"
          ]
        },
        "qt_fingerprint": {
          "description": "JPEG quantization tables (natural order), IJG quality or nearest + distance, table hash and database matches.",
          "type": [
            "object",
            "null"
          ]
        },
        "reference_table": {
          "description": "Comparison with --reference images: n and one row per property (consistent, inconsistent, varies, not_applicable).",
          "type": [
            "object",
            "null"
          ]
        },
        "references": {
          "description": "Reference images used (path, SHA-256, status).",
          "type": [
            "array",
            "null"
          ]
        },
        "pixel_decode_error": {
          "description": "Why the pixels could not be decoded (no preview, map, copy-move or thumbnail comparison).",
          "type": [
            "string",
            "null"
          ]
        },
        "parser_error": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "extracted_files": {
      "description": "Every file the analysis wrote in the item folder, with its digests (also in the audit log).",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rel_path",
          "kind",
          "bytes",
          "hashes"
        ],
        "properties": {
          "rel_path": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "hashes": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9a-f]{32,128}$"
            }
          }
        }
      }
    },
    "case": {
      "type": [
        "object",
        "null"
      ],
      "description": "Present when the run works in a shared case folder (--case-dir).",
      "required": [
        "case_id",
        "role",
        "case_dir",
        "status",
        "intake_utc"
      ],
      "properties": {
        "case_id": {
          "type": "string"
        },
        "role": {
          "enum": [
            "intake",
            "analysis"
          ]
        },
        "case_dir": {
          "type": "string"
        },
        "status": {
          "enum": [
            "registered",
            "already_registered",
            "verified",
            "mismatch",
            "not_in_registry",
            null
          ]
        },
        "intake_utc": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
